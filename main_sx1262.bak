/*
 * nRF52840 LoRa P2P Node — Relay Hop + SX1262
 * Node ID: 116
 *
 * Protocol: RadioHead-compatible headers + XOR encryption + CRC16
 * Packet: [TO=0xFF][FROM=116][ID][FLAGS=hop_count][encrypted_payload+CRC16]
 * Payload: N:116|S:seq|T:temp|H:hum|B:bat
 *
 * Debug OLED: scrolling log display + status lines
 * SPI: software bit-bang using nrf_gpio_* (n-able PINS_COUNT=34 bug)
 * LoRa: SX1262 (command-based SPI)
 * BME280: optional — uses simulated values if not connected
 */

#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_BME280.h>
#include <stdarg.h>
#include <nrf_gpio.h>

// ============ PIN DEFINITIONS ============
#define STATUS_LED   15   // P0.15

// OLED I2C
#define OLED_SDA     36   // P1.04
#define OLED_SCL     11   // P0.11

// SX1262 LoRa SPI — raw GPIO numbers (nrf_gpio_* functions)
#define SX1262_MISO  2    // P0.02
#define SX1262_SCK   43   // P1.11
#define SX1262_MOSI  47   // P1.15
#define SX1262_CS    45   // P1.13
#define SX1262_DIO1  29   // P0.29  (SX1262 uses DIO1 for IRQ, not DIO0)
#define SX1262_RST   9    // P0.09
#define SX1262_BUSY  40   // P1.08  (SX1262 has BUSY pin — ADJUST TO YOUR WIRING)

// Battery
#define BATTERY_PIN  31   // P0.31
#define VBAT_MV_PER_LSB     0.73242188F
#define VBAT_DIVIDER_COMP   1.73F
#define REAL_VBAT_MV_PER_LSB (VBAT_DIVIDER_COMP * VBAT_MV_PER_LSB)

// ============ NETWORK CONFIG ============
#define THIS_NODE_ADDRESS  116
#define BROADCAST_ADDRESS  0xFF
#define MAX_MESSAGE_LEN    251
#define TX_INTERVAL        30000  // 30 seconds

// Crypto key (must match STM32 nodes)
static const char* CRYPTO_KEY = "1234567890000000";
#define CRYPTO_KEY_LEN 16

// ============ RELAY / MULTI-HOP CONFIG ============
#define MAX_HOPS              3
#define RELAY_MEMORY_SIZE     10
#define MESSAGE_QUEUE_SIZE    5
#define RSSI_RELAY_THRESHOLD  -100
#define RELAY_CACHE_TTL       300000  // 5 minutes

// ============ SX1262 COMMAND OPCODES ============
#define SX1262_CMD_SET_SLEEP            0x84
#define SX1262_CMD_SET_STANDBY          0x80
#define SX1262_CMD_SET_TX               0x83
#define SX1262_CMD_SET_RX               0x82
#define SX1262_CMD_SET_PACKET_TYPE      0x8A
#define SX1262_CMD_SET_RF_FREQUENCY     0x86
#define SX1262_CMD_SET_PA_CONFIG        0x95
#define SX1262_CMD_SET_TX_PARAMS        0x8E
#define SX1262_CMD_SET_MODULATION_PARAMS 0x8B
#define SX1262_CMD_SET_PACKET_PARAMS    0x8C
#define SX1262_CMD_SET_DIO_IRQ_PARAMS   0x08
#define SX1262_CMD_CLEAR_IRQ_STATUS     0x02
#define SX1262_CMD_GET_IRQ_STATUS       0x12
#define SX1262_CMD_WRITE_BUFFER         0x0E
#define SX1262_CMD_READ_BUFFER          0x1E
#define SX1262_CMD_GET_RX_BUFFER_STATUS 0x13
#define SX1262_CMD_GET_PACKET_STATUS    0x14
#define SX1262_CMD_GET_STATUS           0xC0
#define SX1262_CMD_SET_BUFFER_BASE_ADDR 0x8F
#define SX1262_CMD_WRITE_REGISTER       0x0D
#define SX1262_CMD_READ_REGISTER        0x1D
#define SX1262_CMD_SET_DIO2_AS_RF_SWITCH 0x9D
#define SX1262_CMD_SET_DIO3_AS_TCXO     0x97
#define SX1262_CMD_CALIBRATE            0x89

// ============ GLOBALS ============
Adafruit_SSD1306 display(128, 64, &Wire, -1);
Adafruit_BME280 bme;

float batteryVoltage = 0;
uint16_t batteryMV = 3300;
bool oled_ok = false;
bool lora_ok = false;
bool bme_ok = false;
int16_t temperature = 25;  // simulated default
int16_t humidity = 50;     // simulated default

// LoRa state
volatile bool lora_rx_flag = false;
uint8_t txSequenceNum = 0;
uint8_t rhMsgId = 0;

// Relay: duplicate detection cache
struct RelayCache {
    uint8_t sourceNode;
    uint8_t sequenceNum;
    uint32_t timestamp;
} relayMemory[RELAY_MEMORY_SIZE];
uint8_t relayCacheIndex = 0;

// Relay: message queue for delayed forwarding
struct MessageQueueEntry {
    uint8_t data[MAX_MESSAGE_LEN + 4];
    uint8_t len;
    uint32_t sendTime;
    bool inUse;
} messageQueue[MESSAGE_QUEUE_SIZE];

// ============ DEBUG OUTPUT SYSTEM ============
#define DBG_LINES 5
#define DBG_COLS  22

char dbgBuf[DBG_LINES][DBG_COLS];
uint8_t dbgIdx = 0;

void dbg(const char* msg) {
    Serial.println(msg);
    strncpy(dbgBuf[dbgIdx], msg, DBG_COLS - 1);
    dbgBuf[dbgIdx][DBG_COLS - 1] = '\0';
    dbgIdx = (dbgIdx + 1) % DBG_LINES;
}

void dbgf(const char* fmt, ...) {
    char tmp[80];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(tmp, sizeof(tmp), fmt, ap);
    va_end(ap);
    dbg(tmp);
}

void updateOLED() {
    if (!oled_ok) return;
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);

    char line[DBG_COLS];

    // Row 0: Node ID + Battery + Uptime
    display.setCursor(0, 0);
    unsigned long upSec = millis() / 1000;
    unsigned long upMin = upSec / 60;
    unsigned long upHr  = upMin / 60;
    if (upHr > 0) {
        snprintf(line, sizeof(line), "N:%-3d %.1fV  %luh%lum",
                 THIS_NODE_ADDRESS, batteryVoltage, upHr, upMin % 60);
    } else {
        snprintf(line, sizeof(line), "N:%-3d %.1fV  %lum%lus",
                 THIS_NODE_ADDRESS, batteryVoltage, upMin, upSec % 60);
    }
    display.print(line);

    // Row 1: Sensor + TX count
    display.setCursor(0, 10);
    snprintf(line, sizeof(line), "%dC %d%%  TX#%d %s",
             temperature, humidity, txSequenceNum,
             bme_ok ? "" : "(sim)");
    display.print(line);

    // Separator line
    display.drawLine(0, 19, 127, 19, SSD1306_WHITE);

    // Row 2-6: scrolling debug log
    for (int i = 0; i < DBG_LINES; i++) {
        int idx = (dbgIdx + i) % DBG_LINES;
        if (dbgBuf[idx][0]) {
            display.setCursor(0, 22 + i * 9);
            display.print(dbgBuf[idx]);
        }
    }

    display.display();
}

// ============ nRF GPIO HELPERS ============
static inline void gpioSet(uint32_t pin)   { nrf_gpio_pin_set(pin); }
static inline void gpioClear(uint32_t pin) { nrf_gpio_pin_clear(pin); }
static inline void gpioWrite(uint32_t pin, bool val) {
    if (val) nrf_gpio_pin_set(pin); else nrf_gpio_pin_clear(pin);
}
static inline uint32_t gpioRead(uint32_t pin) { return nrf_gpio_pin_read(pin); }
static inline void gpioOutput(uint32_t pin) { nrf_gpio_cfg_output(pin); }
static inline void gpioInput(uint32_t pin) {
    nrf_gpio_cfg_input(pin, NRF_GPIO_PIN_NOPULL);
}

// ============ SOFTWARE SPI (bit-bang) ============
uint8_t swSpiTransfer(uint8_t data) {
    uint8_t recv = 0;
    for (int i = 7; i >= 0; i--) {
        gpioWrite(SX1262_MOSI, (data >> i) & 1);
        delayMicroseconds(2);
        gpioSet(SX1262_SCK);
        delayMicroseconds(2);
        if (gpioRead(SX1262_MISO)) recv |= (1 << i);
        gpioClear(SX1262_SCK);
        delayMicroseconds(2);
    }
    return recv;
}

// ============ SX1262 BUSY WAIT ============
bool waitBusy(uint32_t timeoutMs = 100) {
    uint32_t start = millis();
    while (gpioRead(SX1262_BUSY)) {
        if (millis() - start > timeoutMs) return false;
        delayMicroseconds(100);
    }
    return true;
}

// ============ SX1262 COMMAND INTERFACE ============
void sx1262Command(uint8_t cmd, const uint8_t* data, uint8_t len) {
    waitBusy();
    gpioClear(SX1262_CS);
    delayMicroseconds(5);
    swSpiTransfer(cmd);
    for (uint8_t i = 0; i < len; i++) {
        swSpiTransfer(data[i]);
    }
    delayMicroseconds(5);
    gpioSet(SX1262_CS);
    delayMicroseconds(5);
}

void sx1262ReadCommand(uint8_t cmd, uint8_t* data, uint8_t len) {
    waitBusy();
    gpioClear(SX1262_CS);
    delayMicroseconds(5);
    swSpiTransfer(cmd);
    swSpiTransfer(0x00);  // SX1262 requires NOP after read command
    for (uint8_t i = 0; i < len; i++) {
        data[i] = swSpiTransfer(0x00);
    }
    delayMicroseconds(5);
    gpioSet(SX1262_CS);
    delayMicroseconds(5);
}

void sx1262WriteRegister(uint16_t addr, uint8_t value) {
    waitBusy();
    gpioClear(SX1262_CS);
    delayMicroseconds(5);
    swSpiTransfer(SX1262_CMD_WRITE_REGISTER);
    swSpiTransfer((addr >> 8) & 0xFF);
    swSpiTransfer(addr & 0xFF);
    swSpiTransfer(value);
    delayMicroseconds(5);
    gpioSet(SX1262_CS);
    delayMicroseconds(5);
}

uint8_t sx1262ReadRegister(uint16_t addr) {
    waitBusy();
    gpioClear(SX1262_CS);
    delayMicroseconds(5);
    swSpiTransfer(SX1262_CMD_READ_REGISTER);
    swSpiTransfer((addr >> 8) & 0xFF);
    swSpiTransfer(addr & 0xFF);
    swSpiTransfer(0x00);  // NOP
    uint8_t val = swSpiTransfer(0x00);
    delayMicroseconds(5);
    gpioSet(SX1262_CS);
    delayMicroseconds(5);
    return val;
}

void sx1262WriteBuffer(uint8_t offset, const uint8_t* data, uint8_t len) {
    waitBusy();
    gpioClear(SX1262_CS);
    delayMicroseconds(5);
    swSpiTransfer(SX1262_CMD_WRITE_BUFFER);
    swSpiTransfer(offset);
    for (uint8_t i = 0; i < len; i++) {
        swSpiTransfer(data[i]);
    }
    delayMicroseconds(5);
    gpioSet(SX1262_CS);
    delayMicroseconds(5);
}

void sx1262ReadBuffer(uint8_t offset, uint8_t* data, uint8_t len) {
    waitBusy();
    gpioClear(SX1262_CS);
    delayMicroseconds(5);
    swSpiTransfer(SX1262_CMD_READ_BUFFER);
    swSpiTransfer(offset);
    swSpiTransfer(0x00);  // NOP
    for (uint8_t i = 0; i < len; i++) {
        data[i] = swSpiTransfer(0x00);
    }
    delayMicroseconds(5);
    gpioSet(SX1262_CS);
    delayMicroseconds(5);
}

// ============ ENCRYPTION (XOR — matches STM32) ============
void xorEncrypt(const char* plaintext, int len, uint8_t* output) {
    for (int i = 0; i < len; i++) {
        output[i] = plaintext[i] ^ CRYPTO_KEY[i % CRYPTO_KEY_LEN];
    }
}

void xorDecrypt(const uint8_t* ciphertext, int len, char* output) {
    for (int i = 0; i < len; i++) {
        output[i] = ciphertext[i] ^ CRYPTO_KEY[i % CRYPTO_KEY_LEN];
    }
    output[len] = '\0';
}

// ============ CRC16 (matches STM32) ============
uint16_t calculateCRC16(const uint8_t* data, uint8_t length) {
    uint16_t crc = 0xFFFF;
    for (int i = 0; i < length; i++) {
        crc ^= (uint16_t)data[i];
        for (int j = 0; j < 8; j++) {
            if (crc & 1) {
                crc = (crc >> 1) ^ 0xA001;
            } else {
                crc >>= 1;
            }
        }
    }
    return crc;
}

// ============ SX1262 MODEM MODES ============
void setModeStandby() {
    uint8_t cfg = 0x00;  // STDBY_RC
    sx1262Command(SX1262_CMD_SET_STANDBY, &cfg, 1);
}

void setModeRx() {
    // Clear IRQ
    uint8_t clr[] = {0xFF, 0xFF};
    sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
    // RX continuous (timeout = 0xFFFFFF)
    uint8_t rx[] = {0xFF, 0xFF, 0xFF};
    sx1262Command(SX1262_CMD_SET_RX, rx, 3);
}

void setModeSleep() {
    uint8_t cfg = 0x00;  // cold start, no RTC
    sx1262Command(SX1262_CMD_SET_SLEEP, &cfg, 1);
}

// DIO1 interrupt handler
void dio1_isr() {
    lora_rx_flag = true;
}

// ============ RELAY: DUPLICATE DETECTION ============
bool isMessageDuplicate(uint8_t sourceNode, uint8_t seqNum) {
    uint32_t now = millis();
    for (int i = 0; i < RELAY_MEMORY_SIZE; i++) {
        if (relayMemory[i].sourceNode == sourceNode &&
            relayMemory[i].sequenceNum == seqNum &&
            (now - relayMemory[i].timestamp) < RELAY_CACHE_TTL) {
            return true;
        }
    }
    return false;
}

void addToRelayCache(uint8_t sourceNode, uint8_t seqNum) {
    relayMemory[relayCacheIndex].sourceNode = sourceNode;
    relayMemory[relayCacheIndex].sequenceNum = seqNum;
    relayMemory[relayCacheIndex].timestamp = millis();
    relayCacheIndex = (relayCacheIndex + 1) % RELAY_MEMORY_SIZE;
}

// ============ RELAY: MESSAGE QUEUE ============
void addToMessageQueue(const uint8_t* packet, uint8_t len) {
    for (int i = 0; i < MESSAGE_QUEUE_SIZE; i++) {
        if (!messageQueue[i].inUse) {
            memcpy(messageQueue[i].data, packet, len);
            messageQueue[i].len = len;
            uint32_t delayMs = 1000 + random(2000);
            messageQueue[i].sendTime = millis() + delayMs;
            messageQueue[i].inUse = true;
            dbgf("RELAY Q +%lums", delayMs);
            return;
        }
    }
    dbg("RELAY Q full!");
}

void sendRawPacket(const uint8_t* packet, uint8_t len) {
    setModeStandby();
    delay(2);

    // Set buffer base addresses
    uint8_t bufBase[] = {0x00, 0x00};
    sx1262Command(SX1262_CMD_SET_BUFFER_BASE_ADDR, bufBase, 2);

    // Write payload to buffer
    sx1262WriteBuffer(0x00, packet, len);

    // Update packet params with new payload length
    uint8_t pktParams[] = {
        0x00, 0x08,  // preamble: 8 symbols
        0x00,        // explicit header
        len,         // payload length
        0x01,        // CRC on
        0x00         // standard IQ
    };
    sx1262Command(SX1262_CMD_SET_PACKET_PARAMS, pktParams, 6);

    // Clear IRQ and TX
    uint8_t clr[] = {0xFF, 0xFF};
    sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
    uint8_t tx[] = {0x00, 0x00, 0x00};  // no timeout
    sx1262Command(SX1262_CMD_SET_TX, tx, 3);

    // Wait for TxDone (IRQ bit 0)
    uint32_t txStart = millis();
    bool sent = false;
    while (millis() - txStart < 2000) {
        uint8_t irq[2];
        sx1262ReadCommand(SX1262_CMD_GET_IRQ_STATUS, irq, 2);
        if (irq[0] & 0x01) {  // TxDone
            sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
            sent = true;
            break;
        }
        delay(1);
    }

    setModeRx();
    dbg(sent ? "RELAY TX OK" : "RELAY TX timeout!");
    updateOLED();
}

void processMessageQueue() {
    uint32_t now = millis();
    for (int i = 0; i < MESSAGE_QUEUE_SIZE; i++) {
        if (messageQueue[i].inUse && now >= messageQueue[i].sendTime) {
            sendRawPacket(messageQueue[i].data, messageQueue[i].len);
            messageQueue[i].inUse = false;
        }
    }
}

// ============ SX1262 MODEM CONFIG ============
bool configureLoRaModem() {
    setModeStandby();
    delay(5);

    // Set packet type: LoRa
    uint8_t pktType = 0x01;
    sx1262Command(SX1262_CMD_SET_PACKET_TYPE, &pktType, 1);

    // Set frequency: 923 MHz
    // freq_reg = freq_hz * 2^25 / 32MHz
    uint32_t freqReg = (uint32_t)((923000000.0 * (1 << 25)) / 32000000.0);
    uint8_t freq[] = {
        (uint8_t)(freqReg >> 24),
        (uint8_t)(freqReg >> 16),
        (uint8_t)(freqReg >> 8),
        (uint8_t)(freqReg)
    };
    sx1262Command(SX1262_CMD_SET_RF_FREQUENCY, freq, 4);

    // PA config: +14 dBm for SX1262
    uint8_t paConfig[] = {0x04, 0x07, 0x00, 0x01};  // paDutyCycle, hpMax, deviceSel=SX1262, paLut
    sx1262Command(SX1262_CMD_SET_PA_CONFIG, paConfig, 4);

    // TX params: power=14dBm, rampTime=200us
    uint8_t txParams[] = {0x0E, 0x04};
    sx1262Command(SX1262_CMD_SET_TX_PARAMS, txParams, 2);

    // Modulation params: SF7, BW=125kHz, CR=4/5, LowDataRate=off
    uint8_t modParams[] = {0x07, 0x04, 0x01, 0x00};
    sx1262Command(SX1262_CMD_SET_MODULATION_PARAMS, modParams, 4);

    // Packet params: preamble=8, explicit header, payload=MAX, CRC on, standard IQ
    uint8_t pktParams[] = {0x00, 0x08, 0x00, 0xFF, 0x01, 0x00};
    sx1262Command(SX1262_CMD_SET_PACKET_PARAMS, pktParams, 6);

    // Set DIO2 as RF switch control (common on many SX1262 modules)
    uint8_t dio2 = 0x01;
    sx1262Command(SX1262_CMD_SET_DIO2_AS_RF_SWITCH, &dio2, 1);

    // Set sync word for LoRa (0x1424 = public, 0x4434 = private)
    // Using 0x1424 to match RadioHead default
    sx1262WriteRegister(0x0740, 0x14);
    sx1262WriteRegister(0x0741, 0x24);

    // Set buffer base addresses
    uint8_t bufBase[] = {0x00, 0x00};
    sx1262Command(SX1262_CMD_SET_BUFFER_BASE_ADDR, bufBase, 2);

    // DIO1 IRQ: RxDone + TxDone + CRC error
    uint8_t irqParams[] = {
        0x02, 0x03,  // IRQ mask: TxDone(0x01) + RxDone(0x02) + CRCErr(0x40) = 0x0243
        0x02, 0x03,  // DIO1 mask (same)
        0x00, 0x00,  // DIO2 mask (none)
        0x00, 0x00   // DIO3 mask (none)
    };
    sx1262Command(SX1262_CMD_SET_DIO_IRQ_PARAMS, irqParams, 8);

    return true;
}

// ============ LORA INIT ============
bool initLoRa() {
    dbg("SX1262: init...");
    updateOLED();

    gpioOutput(SX1262_CS);
    gpioSet(SX1262_CS);
    gpioInput(SX1262_DIO1);
    gpioInput(SX1262_BUSY);
    gpioOutput(SX1262_RST);
    gpioSet(SX1262_RST);
    delay(10);

    gpioOutput(SX1262_MOSI);
    gpioOutput(SX1262_SCK);
    gpioInput(SX1262_MISO);
    gpioClear(SX1262_MOSI);
    gpioClear(SX1262_SCK);
    delay(100);

    // Reset SX1262
    dbg("SX1262: reset...");
    updateOLED();
    gpioClear(SX1262_RST);
    delay(10);
    gpioSet(SX1262_RST);
    delay(50);

    // Wait for BUSY to go low after reset
    if (!waitBusy(500)) {
        dbg("SX1262: BUSY timeout!");
        updateOLED();
        return false;
    }

    // Check status — get device status
    uint8_t status;
    sx1262ReadCommand(SX1262_CMD_GET_STATUS, &status, 1);
    dbgf("SX1262 status: 0x%02X", status);
    updateOLED();

    // Calibrate all blocks
    uint8_t calMask = 0x7F;
    sx1262Command(SX1262_CMD_CALIBRATE, &calMask, 1);
    delay(10);
    waitBusy(100);

    configureLoRaModem();

    // Start RX continuous + DIO1 interrupt
    setModeRx();
    attachInterrupt(digitalPinToInterrupt(SX1262_DIO1), dio1_isr, RISING);

    dbgf("SX1262: OK N:%d", THIS_NODE_ADDRESS);
    updateOLED();
    return true;
}

// ============ LORA TX (RadioHead compatible) ============
void sendPacket() {
    if (!lora_ok) return;

    char payload[80];
    snprintf(payload, sizeof(payload), "N:%d|S:%d|T:%d|H:%d|B:%d",
             THIS_NODE_ADDRESS, txSequenceNum,
             temperature, humidity, batteryMV);

    int payloadLen = strlen(payload);

    uint8_t encrypted[payloadLen + 2];
    xorEncrypt(payload, payloadLen, encrypted);

    uint16_t crc = calculateCRC16(encrypted, payloadLen);
    encrypted[payloadLen] = (crc >> 8) & 0xFF;
    encrypted[payloadLen + 1] = crc & 0xFF;
    uint8_t encLen = payloadLen + 2;

    uint8_t totalLen = 4 + encLen;
    uint8_t packet[totalLen];
    packet[0] = BROADCAST_ADDRESS;
    packet[1] = THIS_NODE_ADDRESS;
    packet[2] = rhMsgId++;
    packet[3] = 0x00;  // hop count = 0 (origin)
    memcpy(&packet[4], encrypted, encLen);

    // Standby → buffer → TX
    setModeStandby();
    delay(2);

    uint8_t bufBase[] = {0x00, 0x00};
    sx1262Command(SX1262_CMD_SET_BUFFER_BASE_ADDR, bufBase, 2);
    sx1262WriteBuffer(0x00, packet, totalLen);

    // Update packet params with payload length
    uint8_t pktParams[] = {
        0x00, 0x08,  // preamble: 8 symbols
        0x00,        // explicit header
        totalLen,    // payload length
        0x01,        // CRC on
        0x00         // standard IQ
    };
    sx1262Command(SX1262_CMD_SET_PACKET_PARAMS, pktParams, 6);

    // Clear IRQ and start TX
    uint8_t clr[] = {0xFF, 0xFF};
    sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
    uint8_t tx[] = {0x00, 0x00, 0x00};
    sx1262Command(SX1262_CMD_SET_TX, tx, 3);

    uint32_t txStart = millis();
    bool sent = false;
    while (millis() - txStart < 2000) {
        uint8_t irq[2];
        sx1262ReadCommand(SX1262_CMD_GET_IRQ_STATUS, irq, 2);
        if (irq[0] & 0x01) {  // TxDone
            sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
            sent = true;
            break;
        }
        delay(1);
    }

    setModeRx();

    if (sent) {
        dbgf("TX S:%d OK", txSequenceNum);
    } else {
        dbg("TX: timeout!");
    }

    txSequenceNum++;
    updateOLED();
}

// ============ LORA RX (RadioHead compatible) ============
void receivePacket() {
    if (!lora_ok || !lora_rx_flag) return;
    lora_rx_flag = false;

    // Get IRQ status
    uint8_t irq[2];
    sx1262ReadCommand(SX1262_CMD_GET_IRQ_STATUS, irq, 2);

    // Check RxDone (bit 1) and no CRC error (bit 6)
    if (!(irq[0] & 0x02)) {
        uint8_t clr[] = {0xFF, 0xFF};
        sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
        setModeRx();
        return;
    }
    if (irq[0] & 0x40) {
        dbg("RX: CRC hw fail!");
        uint8_t clr[] = {0xFF, 0xFF};
        sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
        setModeRx();
        return;
    }

    // Get RX buffer status (payload length + start offset)
    uint8_t rxBufStatus[2];
    sx1262ReadCommand(SX1262_CMD_GET_RX_BUFFER_STATUS, rxBufStatus, 2);
    uint8_t rxLen = rxBufStatus[0];
    uint8_t rxOffset = rxBufStatus[1];

    if (rxLen < 7 || rxLen > MAX_MESSAGE_LEN) {
        uint8_t clr[] = {0xFF, 0xFF};
        sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);
        setModeRx();
        return;
    }

    // Read packet from buffer
    uint8_t packet[rxLen];
    sx1262ReadBuffer(rxOffset, packet, rxLen);

    // Get RSSI from packet status
    uint8_t pktStatus[3];
    sx1262ReadCommand(SX1262_CMD_GET_PACKET_STATUS, pktStatus, 3);
    int16_t rssi = -(int16_t)pktStatus[0] / 2;

    // Clear IRQ
    uint8_t clr[] = {0xFF, 0xFF};
    sx1262Command(SX1262_CMD_CLEAR_IRQ_STATUS, clr, 2);

    // Parse RadioHead header
    uint8_t rhTo    = packet[0];
    uint8_t rhFrom  = packet[1];
    uint8_t rhFlags = packet[3];
    uint8_t hopCount = rhFlags & 0x0F;

    if (rhTo != BROADCAST_ADDRESS && rhTo != THIS_NODE_ADDRESS) {
        setModeRx();
        return;
    }

    uint8_t dataLen = rxLen - 4;
    if (dataLen < 3) {
        setModeRx();
        return;
    }

    // Verify CRC16
    uint8_t encLen = dataLen - 2;
    uint16_t receivedCRC = ((uint16_t)packet[4 + encLen] << 8) | packet[4 + encLen + 1];
    uint16_t calcCRC = calculateCRC16(&packet[4], encLen);

    if (receivedCRC != calcCRC) {
        dbg("RX: CRC fail!");
        setModeRx();
        updateOLED();
        return;
    }

    // Decrypt
    char decrypted[encLen + 1];
    xorDecrypt(&packet[4], encLen, decrypted);

    // Parse source node + sequence + sensor values
    uint8_t srcNode = 0;
    uint8_t seqNum = 0;
    int16_t rxTemp = 0;
    int16_t rxHum = 0;
    uint16_t rxBat = 0;
    String msg = String(decrypted);

    int nPos = msg.indexOf("N:");
    if (nPos != -1) {
        int pipe = msg.indexOf("|", nPos);
        if (pipe != -1) srcNode = msg.substring(nPos + 2, pipe).toInt();
    }
    int sPos = msg.indexOf("S:");
    if (sPos != -1) {
        int pipe = msg.indexOf("|", sPos);
        if (pipe != -1) seqNum = msg.substring(sPos + 2, pipe).toInt();
    }
    int tPos = msg.indexOf("T:");
    if (tPos != -1) {
        int pipe = msg.indexOf("|", tPos);
        if (pipe != -1) rxTemp = msg.substring(tPos + 2, pipe).toInt();
    }
    int hPos = msg.indexOf("H:");
    if (hPos != -1) {
        int pipe = msg.indexOf("|", hPos);
        if (pipe != -1) rxHum = msg.substring(hPos + 2, pipe).toInt();
    }
    int bPos = msg.indexOf("B:");
    if (bPos != -1) {
        rxBat = msg.substring(bPos + 2).toInt();
    }

    dbgf("RX N:%d S:%d R:%d H:%d", srcNode, seqNum, rssi, hopCount);
    dbgf(" T:%d H:%d%% B:%dmV", rxTemp, rxHum, rxBat);
    Serial.print(F("[RX from:"));
    Serial.print(rhFrom);
    Serial.print(F(" src:"));
    Serial.print(srcNode);
    Serial.print(F(" hop:"));
    Serial.print(hopCount);
    Serial.print(F(" rssi:"));
    Serial.print(rssi);
    Serial.print(F("] "));
    Serial.println(decrypted);

    // ---- Relay logic ----
    // Guard: skip if this is our own data (echo from another relay)
    if (srcNode == THIS_NODE_ADDRESS || rhFrom == THIS_NODE_ADDRESS) {
        dbgf("RX: own echo N:%d skip", srcNode);
    } else if (srcNode == 0) {
        dbg("RX: bad parse skip");
    } else {
        if (isMessageDuplicate(srcNode, seqNum)) {
            dbg("RX: dup skip");
        } else {
            addToRelayCache(srcNode, seqNum);

            if (rssi <= RSSI_RELAY_THRESHOLD && hopCount < MAX_HOPS) {
                uint8_t relayPkt[rxLen];
                memcpy(relayPkt, packet, rxLen);
                relayPkt[0] = BROADCAST_ADDRESS;
                relayPkt[1] = THIS_NODE_ADDRESS;
                relayPkt[2] = rhMsgId++;
                relayPkt[3] = (hopCount + 1) & 0x0F;
                addToMessageQueue(relayPkt, rxLen);
                dbgf("FWD N:%d T:%d H:%d%%", srcNode, rxTemp, rxHum);
                dbgf(" H:%d>%d R:%d", hopCount, hopCount + 1, rssi);
            } else if (hopCount >= MAX_HOPS) {
                dbgf("RX: maxhop %d N:%d", hopCount, srcNode);
            } else {
                dbgf("RX: no relay R:%d", rssi);
            }
        }
    }

    setModeRx();
    updateOLED();
}

// ============ BATTERY ============
float readBattery() {
    analogReadResolution(12);
    uint16_t raw = analogRead(BATTERY_PIN);
    return (raw * REAL_VBAT_MV_PER_LSB) / 1000.0f;
}

// ============ I2C SCAN ============
void scanI2C() {
    uint8_t count = 0;
    for (uint8_t addr = 1; addr < 127; addr++) {
        Wire.beginTransmission(addr);
        if (Wire.endTransmission() == 0) {
            dbgf("I2C: 0x%02X found", addr);
            count++;
        }
    }
    dbgf("I2C: %d device(s)", count);
}

// ============ SETUP ============
void setup() {
    pinMode(STATUS_LED, OUTPUT);
    digitalWrite(STATUS_LED, LOW);

    Serial.begin(115200);
    delay(2000);
    Serial.println(F("\n=== nRF52840 LoRa P2P Node 116 (SX1262) ==="));

    // I2C
    Wire.setPins(OLED_SDA, OLED_SCL);
    Wire.begin();
    delay(100);

    // OLED
    if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
        if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3D)) {
            Serial.println(F("[-] OLED FAILED"));
        } else {
            oled_ok = true;
        }
    } else {
        oled_ok = true;
    }

    if (oled_ok) {
        display.clearDisplay();
        display.setTextSize(2);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(0, 0);
        display.println(F("Node 116"));
        display.setTextSize(1);
        display.println(F("SX1262 init..."));
        display.display();
    }

    dbg("=== Node 116 ===");
    dbg(oled_ok ? "OLED: OK" : "OLED: FAIL!");
    updateOLED();

    scanI2C();
    updateOLED();

    // BME280 init
    if (bme.begin(0x76)) {
        bme_ok = true;
    } else if (bme.begin(0x77)) {
        bme_ok = true;
    }
    if (bme_ok) {
        bme.setSampling(Adafruit_BME280::MODE_FORCED,
                        Adafruit_BME280::SAMPLING_X1,
                        Adafruit_BME280::SAMPLING_NONE,
                        Adafruit_BME280::SAMPLING_X1,
                        Adafruit_BME280::FILTER_OFF);
        dbg("BME280: OK");
    } else {
        dbg("BME280: sim mode");
    }
    updateOLED();

    // LoRa init
    lora_ok = initLoRa();
    if (!lora_ok) {
        dbg("SX1262: FAILED!");
    }
    updateOLED();

    dbg("Ready.");
    updateOLED();

    digitalWrite(STATUS_LED, HIGH);
    delay(1000);
}

// ============ LOOP ============
void loop() {
    static unsigned long lastBat = 0;
    static unsigned long lastDisplay = 0;
    static unsigned long lastTx = 0;

    // RX has priority
    receivePacket();

    // Process relay queue
    processMessageQueue();

    // Battery + BME280 every 2s
    if (millis() - lastBat >= 2000) {
        lastBat = millis();
        batteryVoltage = readBattery();
        batteryMV = (uint16_t)(batteryVoltage * 1000);
        if (bme_ok) {
            bme.takeForcedMeasurement();
            temperature = (int16_t)bme.readTemperature();
            humidity = (int16_t)bme.readHumidity();
        }
    }

    // Update OLED every 1s
    if (millis() - lastDisplay >= 1000) {
        lastDisplay = millis();
        updateOLED();
    }

    // TX every 30s
    if (lora_ok && millis() - lastTx >= TX_INTERVAL) {
        lastTx = millis();
        sendPacket();
    }
}
